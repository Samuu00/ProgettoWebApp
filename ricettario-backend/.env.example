# Variabili d'ambiente lette da src/main/resources/application.properties.
# Copia in .env (ignorato da git) ed esportale prima di avviare il backend.
DB_URL=jdbc:postgresql://localhost:5432/ricettario
DB_USER=postgres
DB_PASSWORD=change-me

# Obbligatoria: almeno 32 caratteri casuali (es. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
# Per Gmail usa una "App password", mai la password dell'account
MAIL_PASSWORD=change-me
MAIL_FROM=your-address@gmail.com

FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
